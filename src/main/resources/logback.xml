<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%date{HH:mm:ss.SSS} %-5level [%logger{36}] - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="BOARD_FILE" class="ch.qos.logback.core.FileAppender">
        <file>info.log</file>
        <append>true</append>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <logger name="gameoflife.board" level="INFO" additivity="false">
        <appender-ref ref="BOARD_FILE" />
    </logger>

    <logger name="org.apache.pekko" level="INFO" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>